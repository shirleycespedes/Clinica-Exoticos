# ==========================================
# Configuración del Servidor y Entorno
# ==========================================
NODE_ENV=production
PORT=3000
API_PREFIX=/api/v1

# ==========================================
# Base de Datos (MySQL en Railway o Local)
# ==========================================
DB_HOST=containers-us-west-xxx.railway.app
DB_PORT=3306
DB_USER=root
DB_PASSWORD=tu_password_mysql
DB_NAME=railway

# ==========================================
# Autenticación JWT
# ==========================================
JWT_SECRET=tu_clave_secreta_jwt_muy_segura_123456
JWT_EXPIRES_IN=24h

# ==========================================
# Servicio de Correos (2FA y Restablecimiento)
# ==========================================
# OPCIÓN 1 (RECOMENDADA): BREVO (Envía a CUALQUIER usuario, GRATIS, SIN DOMINIO)
# Registrate en: https://www.brevo.com (300 correos gratis al día)
# 1. En Brevo: perfil > SMTP & API > API Keys > Generate a new API key
# 2. Configura aquí la clave generada:
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-xxxxxxxx
# 3. Coloca tu correo verificado en Brevo (ej: tu cuenta de Gmail con la que te registraste):
EMAIL_FROM=VetExóticos <tu_correo@gmail.com>

# OPCIÓN 2 (OPCIONAL): SENDGRID (Single Sender Verification)
# SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxx

# OPCIÓN 3 (OPCIONAL): RESEND (Requiere dominio verificado para enviar a terceros)
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxx

# ==========================================
# Google Auth (Opcional)
# ==========================================
GOOGLE_CLIENT_ID=tu_cliente_id_web_de_google.apps.googleusercontent.com
