# ==========================================
# Configuración del Servidor y Entorno
# ==========================================
NODE_ENV=production
PORT=3000
API_PREFIX=/api/v1

# ==========================================
# Base de Datos (MySQL en Railway o Local)
# ==========================================
DB_HOST=containers-us-west-xxx.railway.app
DB_PORT=3306
DB_USER=root
DB_PASSWORD=tu_password_mysql
DB_NAME=railway

# ==========================================
# Autenticación JWT
# ==========================================
JWT_SECRET=tu_clave_secreta_jwt_muy_segura_123456
JWT_EXPIRES_IN=24h

# ==========================================
# Servicio de Envío de Correos (2FA y Restablecimiento)
# ==========================================
# RECOMENDADO PARA RAILWAY (API HTTPS en Puerto 443 - No se bloquea):
# Obtené tu clave gratuita en: https://resend.com (3.000 correos gratis/mes)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Remitente de correo:
# Para pruebas sin dominio propio en Resend: 'VetExóticos <onboarding@resend.dev>'
# Con dominio verificado propio: 'VetExóticos <contacto@tudominio.com>'
EMAIL_FROM=VetExóticos <onboarding@resend.dev>

# Alternativa SMTP tradicional (Nota: Railway bloquea el puerto 25 y restringe 465/587):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=tu_correo@gmail.com
# SMTP_PASS=tu_contraseña_de_aplicacion_gmail

# ==========================================
# Google Auth (Opcional)
# ==========================================
GOOGLE_CLIENT_ID=tu_cliente_id_web_de_google.apps.googleusercontent.com
